rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function membership(fid) { return get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)); }
    function member(fid) { return signed() && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)); }
    function role(fid) { return membership(fid).data.role; }
    function owner(fid) { return member(fid) && role(fid) == 'owner'; }
    function editor(fid) { return member(fid) && (role(fid) == 'owner' || role(fid) == 'editor'); }
    function invited(fid) {
      return signed() &&
        exists(/databases/$(database)/documents/families/$(fid)/invites/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/families/$(fid)/invites/$(request.auth.token.email)).data.email == request.auth.token.email;
    }
    match /families/{fid} {
      allow create: if signed() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','title','createdAt']);
      allow read: if member(fid);
      allow update, delete: if false;
      match /members/{uid} {
        allow read: if member(fid) && (owner(fid) || request.auth.uid == uid);
        allow create: if signed() && request.resource.data.uid == uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.keys().hasOnly(['uid','email','role','joinedAt']) &&
          ((request.auth.uid == uid &&
            get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == uid &&
            request.resource.data.role == 'owner') ||
           (request.auth.uid == uid && invited(fid) &&
             request.resource.data.role == get(/databases/$(database)/documents/families/$(fid)/invites/$(request.auth.token.email)).data.role &&
             request.resource.data.role in ['editor','viewer']));
        allow update: if false;
        allow delete: if owner(fid) && uid != request.auth.uid;
      }
      match /invites/{email} {
        allow read: if owner(fid) || (signed() && request.auth.token.email == email);
        allow create, update: if owner(fid) && request.resource.data.email == email &&
          request.resource.data.role in ['editor','viewer'] &&
          request.resource.data.invitedBy == request.auth.uid &&
          request.resource.data.keys().hasOnly(['email','role','invitedBy','createdAt']);
        allow delete: if owner(fid);
      }
      match /entries/{eid} {
        allow read: if member(fid);
        allow create, update: if editor(fid) &&
          request.resource.data.keys().hasOnly(['payload','updatedAt','editedBy']) &&
          request.resource.data.editedBy == request.auth.uid &&
          request.resource.data.payload.id == eid &&
          request.resource.data.payload.t is number &&
          request.resource.data.payload.keys().size() <= 40;
        allow delete: if editor(fid);
      }
    }
  }
}
